[Unit] 
Description=EuanMorton.co.uk Server  


[Service] 

# ExecStart=/home/Projects/EM_Website/npm run start
WorkingDirectory=/home/Projects/EM_Website
ExecStart=/usr/bin/npm start

# Restart service after 10 seconds if node service crashes
RestartSec=10
Restart=always
Restart=on-failure 

# Output to syslog
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=nodejs-my-server-example


[Install] 
WantedBy=multi-user.target
